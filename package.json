{
  "name": "flownav",
  "version": "0.2.1",
  "description": "See what references an n8n node before you rename it. A typed graph of your workflows with a CLI and an MCP server, so AI agents read a few lines instead of the whole workflow JSON.",
  "author": "Omer Turkenits",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OmerTurkenits/flownav.git"
  },
  "homepage": "https://github.com/OmerTurkenits/flownav#readme",
  "bugs": {
    "url": "https://github.com/OmerTurkenits/flownav/issues"
  },
  "type": "module",
  "bin": {
    "flownav": "dist/cli.js",
    "fnav": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=22.12"
  },
  "keywords": [
    "n8n",
    "workflow",
    "workflow-automation",
    "graph",
    "mcp",
    "model-context-protocol",
    "ai",
    "ai-agents",
    "claude",
    "rename",
    "static-analysis",
    "cli"
  ],
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
