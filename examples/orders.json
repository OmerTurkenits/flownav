{
  "id": "wf-orders",
  "name": "Order intake",
  "active": true,
  "settings": {
    "errorWorkflow": "wf-errors"
  },
  "nodes": [
    {
      "id": "1",
      "name": "Order Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "path": "orders",
        "httpMethod": "POST",
        "responseMode": "responseNode"
      }
    },
    {
      "id": "2",
      "name": "Normalize",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "email",
              "value": "={{ $json.body.email }}"
            },
            {
              "name": "total",
              "value": "={{ $json.body.total }}"
            }
          ]
        }
      }
    },
    {
      "id": "3",
      "name": "Is Large Order",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.total }}",
              "rightValue": 500
            }
          ]
        }
      }
    },
    {
      "id": "4",
      "name": "Notify Sales",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [
        660,
        -80
      ],
      "credentials": {
        "slackApi": {
          "id": "cred-slack",
          "name": "Sales Slack"
        }
      },
      "parameters": {
        "resource": "message",
        "operation": "post",
        "channelId": "C123SALES",
        "text": "={{ 'Big order from ' + $('Normalize').item.json.email }}"
      }
    },
    {
      "id": "5",
      "name": "Save Order",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        660,
        80
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "cred-gs",
          "name": "Orders Sheet"
        }
      },
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "SHEET_ORDERS",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Orders",
          "mode": "list"
        }
      }
    },
    {
      "id": "6",
      "name": "Enrich",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [
        880,
        80
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "wf-enrich",
          "mode": "id",
          "cachedResultName": "Enrich customer"
        }
      }
    },
    {
      "id": "7",
      "name": "Reply",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: true, customer: $('Enrich').item.json.customerId, notified: $('Notify Sales').item.json.ok } }}"
      }
    },
    {
      "id": "8",
      "name": "Support Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        440,
        400
      ],
      "parameters": {}
    },
    {
      "id": "9",
      "name": "Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [
        380,
        600
      ],
      "credentials": {
        "openAiApi": {
          "id": "cred-oai",
          "name": "OpenAI"
        }
      },
      "parameters": {}
    },
    {
      "id": "10",
      "name": "Lookup Order",
      "type": "@n8n/n8n-nodes-langchain.toolWorkflow",
      "typeVersion": 1.3,
      "position": [
        560,
        600
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "wf-enrich",
          "mode": "id"
        }
      }
    },
    {
      "id": "11",
      "name": "Loop Orders",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        0,
        400
      ],
      "parameters": {
        "batchSize": 10
      }
    },
    {
      "id": "12",
      "name": "Ping Self",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        400
      ],
      "parameters": {
        "method": "POST",
        "url": "https://n8n.example.com/webhook/orders",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer example-not-a-real-token-0000"
            }
          ]
        }
      }
    },
    {
      "id": "13",
      "name": "Orphan Code",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        400
      ],
      "parameters": {
        "jsCode": "const row = $('Normalize').first().json.email;\nconst gone = $('Deleted Step').first().json.x;\nreturn [{ json: { row, gone } }];"
      }
    },
    {
      "id": "14",
      "name": "Section: intake",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -140
      ],
      "parameters": {
        "content": "## Intake\nwebhook to branch",
        "width": 760,
        "height": 400
      }
    },
    {
      "id": "15",
      "name": "Chat Trigger",
      "type": "@n8n/n8n-nodes-langchain.chatTrigger",
      "typeVersion": 1.1,
      "position": [
        200,
        300
      ],
      "parameters": {}
    },
    {
      "id": "16",
      "name": "Nightly",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -220,
        400
      ],
      "parameters": {}
    }
  ],
  "connections": {
    "Order Webhook": {
      "main": [
        [
          {
            "node": "Normalize",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize": {
      "main": [
        [
          {
            "node": "Is Large Order",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Large Order": {
      "main": [
        [
          {
            "node": "Notify Sales",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Save Order",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Notify Sales": {
      "main": [
        [
          {
            "node": "Reply",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Save Order": {
      "main": [
        [
          {
            "node": "Enrich",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Enrich": {
      "main": [
        [
          {
            "node": "Reply",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Chat Model": {
      "ai_languageModel": [
        [
          {
            "node": "Support Agent",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Lookup Order": {
      "ai_tool": [
        [
          {
            "node": "Support Agent",
            "type": "ai_tool",
            "index": 0
          }
        ]
      ]
    },
    "Loop Orders": {
      "main": [
        [],
        [
          {
            "node": "Ping Self",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ping Self": {
      "main": [
        [
          {
            "node": "Loop Orders",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Chat Trigger": {
      "main": [
        [
          {
            "node": "Support Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Nightly": {
      "main": [
        [
          {
            "node": "Loop Orders",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {
    "Order Webhook": [
      {
        "json": {
          "body": {
            "email": "secret@example.com"
          }
        }
      }
    ]
  }
}